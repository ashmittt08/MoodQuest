# --- Server ---
PORT=4000
# Origin(s) allowed to call the API (comma-separated for several).
FRONTEND_URL=http://localhost:5173

# --- Database (PostgreSQL) ---
# Create it first, e.g. in psql:
#   CREATE USER moodquest WITH PASSWORD 'change-me';
#   CREATE DATABASE moodquest OWNER moodquest;
DATABASE_URL=postgresql://moodquest:change-me@localhost:5432/moodquest

# --- Auth ---
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN_MINUTES=60

# --- Emergency page resources (set for your region) ---
EMERGENCY_NUMBER=112
HELPLINE_NAME=Tele-MANAS National Mental Health Helpline
HELPLINE_NUMBER=14416
HELPLINE_AVAILABILITY=Available 24/7

# --- Phase 2 integration switches (leave as-is for Phase 1) ---
ASSISTANT_PROVIDER=rule_based
EMOTION_PROVIDER=none

# --- Tests only: a separate database that the test suite may wipe ---
TEST_DATABASE_URL=postgresql://moodquest:change-me@localhost:5432/moodquest_test
